# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` AT THE REPOSITORY ROOT and fill it in:
#
#     cp .env.example .env
#
# One file serves all three packages: the local API server
# (apps/api/src/local.ts), Vite (apps/web), and the CDK deploy (infra).
#
# In production these become Lambda environment variables, set by the CDK from
# this same file at deploy time. Never commit .env — only this example.
# ─────────────────────────────────────────────────────────────────────────────

# ── apps/api — required ──────────────────────────────────────────────────────

# MongoDB Atlas connection string (M0 free cluster).
#
# Atlas offers two forms under Connect -> Drivers, and the driver version you
# pick decides which you get:
#
#   Node.js 3.6+          mongodb+srv://<user>:<password>@<cluster>.mongodb.net/...
#   Node.js 2.2.12+       mongodb://<user>:<password>@<host-00>:27017,<host-01>:27017,...
#
# Prefer the SECOND on any machine whose DNS cannot answer SRV queries - a
# corporate resolver, a local stub listener on 127.0.0.1, some VPNs. The `+srv`
# form needs an SRV lookup before it can connect at all, and fails with
# `querySrv ECONNREFUSED` when that lookup is refused. See the README's
# troubleshooting section.
#
# Replace the WHOLE host, not just the credentials: `<cluster>` below is a blank,
# and so is the `cluster0.a1b2c3d` that appears in MongoDB's own documentation.
MONGODB_URI=

# HS256 secret used to sign JWTs. MINIMUM 32 characters — the app refuses to
# start with less. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# ── apps/api — optional, all have defaults ───────────────────────────────────

# Database name inside the cluster. Default: expense_tracker
MONGODB_DB=expense_tracker

# Token lifetime. Accepts 15m, 1h, 7d. Default: 7d
JWT_TTL=7d

# Google Gemini API key, used by auto-categorisation (POST /ai/categorize).
# Free, no credit card: https://aistudio.google.com/apikey
#
# OPTIONAL ON PURPOSE: without it the app still starts and works end to end —
# categorisation falls back to the deterministic rule pre-pass and the
# "Uncategorised" fallback, and the response says which one answered. You can
# review this project without a Google account; only the model step is
# unavailable.
#
# Note: Google's free tier permits using submitted data to improve their models.
# Fine for demo data; a real deployment would want a paid tier.
GEMINI_API_KEY=

# Model used for categorisation AND for reading receipts. Flash-lite is fast
# enough for a synchronous call inside a form.
#
# Worth knowing: model names get retired, and a retired name answers 404, not a
# helpful error. If reads start failing everywhere at once, check this first.
# Default: gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.5-flash-lite

# The second rung of the receipt-reading ladder: a different MODEL, not a
# different provider.
#
# Groq has no multimodal model, so a receipt has nowhere else to go. Google
# pools capacity per model though, so a second model is a second queue - one
# returned 503 in the same minute the other answered in a second.
# Default: gemini-3.1-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# OpenRouter API key - the second VENDOR for READING RECEIPTS.
# Free, sign up with an email: https://openrouter.ai/keys
#
# Optional, and it covers a different failure from GEMINI_FALLBACK_MODEL above.
# Hedging two Gemini models survives a congested model; it does nothing for a
# revoked key, an exhausted daily quota, or a Google outage, because all of those
# take every Gemini model down at once. This is the rung that survives those.
#
# Leave it blank and the reader is Gemini-only, exactly as before.
OPENROUTER_API_KEY=

# Which model reads the receipt. Picked by TESTING, not by reading a table:
#   - google/gemma-4-31b-it:free  was rate-limited upstream on the first call
#   - dots-studio/dots-3-note-preview:free  returned a malformed amount
#   - minimax/minimax-m3:free  read it correctly on every attempt, and is the
#     only candidate with no Google in it - which is the point of this rung
#
# Note: OpenRouter advertising `response_format` does NOT mean the upstream
# honours it. These models ignore the schema and are steered by an explicit
# instruction in the prompt instead - see openrouter.ts.
# Default: minimax/minimax-m3:free
OPENROUTER_MODEL=minimax/minimax-m3:free

# Groq API key — the SECOND provider in the categorisation chain.
# Free, no credit card: https://console.groq.com/keys
#
# Also optional. Measured against Gemini's free tier, roughly a third of calls
# came back 503/504 under load; a retry on the same provider just queues behind
# the same congestion, so the fallback is a different provider on independent
# infrastructure. Set both keys and the chain is Gemini -> Groq -> rule fallback.
GROQ_API_KEY=

# Groq model. Measured across 8 descriptions: gpt-oss-120b answered 7/8 at a
# 729 ms median; gpt-oss-20b was faster but failed 4/8 schema validation, and
# qwen3.6-27b failed all 8. Default: openai/gpt-oss-120b
GROQ_MODEL=openai/gpt-oss-120b

# Comma-separated CORS allowlist. In dev this is the Vite origin. In production
# CloudFront serves the site and the API under the SAME host, so there is no
# cross-origin request and this only matters if someone calls API Gateway
# directly. Default: http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Port for the local dev server. Not used on Lambda. Default: 3000
PORT=3000

# ── apps/web ─────────────────────────────────────────────────────────────────

# API base URL. LEAVE THIS EMPTY in both dev and production.
#
# The app talks to a same-origin "/api" by default. In dev the Vite proxy
# forwards that to the local API server; in production CloudFront forwards it to
# API Gateway. Same path, same behaviour, no URL baked into the build.
#
# Set it only to point a local UI at an already-deployed API, e.g.
#   VITE_API_URL=https://d111111abcdef8.cloudfront.net/api
VITE_API_URL=

# ── infra (CDK) ──────────────────────────────────────────────────────────────

# Deploy region. Default: us-east-1
CDK_DEFAULT_REGION=us-east-1
